---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { site } from '@data/site';
---
<BaseLayout
  title="Privacy Policy"
  description="Privacy Policy for Florida FR44 Auto Insurance — how we collect, use, and protect your information."
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Privacy Policy', href: '/privacy-policy/' }]} />
  </div>
  <section class="section-tight">
    <div class="container legal-content">
      <h1>Privacy Policy</h1>
      <p class="updated">Last updated: January 2026</p>

      <h2>Information we collect</h2>
      <p>When you request a quote or contact us, we may collect information such as your name, phone number, email address, vehicle details, and driving history. This information is used solely to provide insurance quotes and related services.</p>

      <h2>How we use your information</h2>
      <p>We use the information you provide to prepare insurance quotes, communicate with you about your policy, and, where applicable, file required documentation (such as FR44 or SR22 certificates) with the State of Florida. We do not sell your personal information to third parties.</p>

      <h2>Communication preferences</h2>
      <p>By submitting a quote request or contact form, you consent to being contacted by phone, text message, or email regarding your inquiry. Message and data rates may apply for SMS communication. You may opt out of text communication at any time by replying STOP.</p>

      <h2>Data security</h2>
      <p>We take reasonable measures to protect the information you share with us. However, no method of electronic transmission or storage is completely secure, and we cannot guarantee absolute security.</p>

      <h2>Third-party carriers</h2>
      <p>To provide accurate quotes, we may share relevant information with insurance carriers for the purpose of generating quotes on your behalf. Those carriers maintain their own privacy practices.</p>

      <h2>Cookies and analytics</h2>
      <p>Our website may use basic analytics tools to understand site usage and improve the user experience. These tools do not collect sensitive personal information.</p>

      <h2>Contact us</h2>
      <p>If you have questions about this Privacy Policy, contact us at <a href={`mailto:${site.email}`}>{site.email}</a> or {site.phone}.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-content { max-width: 760px; }
  .updated { color: var(--color-gray-500); font-size: 0.88rem; margin-bottom: 2rem; }
  .legal-content h2 { margin-top: 2rem; }
</style>
