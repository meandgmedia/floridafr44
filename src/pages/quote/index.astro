---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { site } from '@data/site';
---
<BaseLayout
  title="Get a Free FR44 &amp; Auto Insurance Quote"
  description="Request a free Florida FR44, SR22, or auto insurance quote. Fast answers, multiple carriers compared, and friendly service. Texting preferred."
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Get a Free Quote', href: '/quote/' }]} />
  </div>

  <section class="section-tight">
    <div class="container quote-hero">
      <span class="eyebrow">Free, No-Obligation Quote</span>
      <h1>Get your free Florida insurance quote</h1>
      <p class="lead">
        Tell us a little about yourself and your vehicle, and we'll compare rates across multiple Florida-licensed carriers to find coverage that fits — FR44, SR22, or standard auto insurance.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container quote-grid">
      <div class="quote-benefits">
        <h2>Why request a quote with us?</h2>
        <ul class="benefit-list">
          <li>
            <strong>Fast turnaround.</strong>
            <span>Most quotes are ready within minutes during business hours.</span>
          </li>
          <li>
            <strong>Multiple carriers compared.</strong>
            <span>We check several Florida-licensed insurers so you don't have to shop around yourself.</span>
          </li>
          <li>
            <strong>No pressure, no spam.</strong>
            <span>We'll walk you through your options in plain English — you decide what's next.</span>
          </li>
          <li>
            <strong>FR44 and SR22 experience.</strong>
            <span>We specialize in high-risk filings and know Florida's requirements inside and out.</span>
          </li>
          <li>
            <strong>Statewide service.</strong>
            <span>Miami to Pensacola, we quote drivers anywhere in Florida.</span>
          </li>
        </ul>

        <div class="card agent-card">
          <div class="agent-avatar" aria-hidden="true">MS</div>
          <div class="agent-details">
            <span class="info-label">Meet Your Agent</span>
            <h3>Matt Saffian</h3>
            <p class="agent-license">Florida Resident License #G273626</p>
            <p class="agent-note">I personally handle every FR44 and SR22 case that comes through — text me directly with any questions about your quote.</p>
          </div>
        </div>

        <div class="quote-text-cta">
          <h3>Prefer to skip the form?</h3>
          <p>Text your name and city to <a href={site.smsHref}>{site.phone}</a> and we'll get started right away. Texting is the fastest way to reach us.</p>
          <a href={site.smsHref} class="btn btn-outline btn-block">Text Us Instead</a>
        </div>
      </div>

      <div class="quote-form-wrap card">
        <h2>Request your free quote</h2>
        <p class="form-note">Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">required</span> are required.</p>

        <!-- Connected to Web3Forms — https://web3forms.com/ -->
        <form class="quote-form" id="quote-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="f73cd747-af2e-4e36-ab53-f38ab1c97ccc" />
          <input type="hidden" name="subject" value="New Quote Request — Florida FR44 Auto Insurance" />
          <input type="hidden" name="from_name" value="Florida FR44 Auto Insurance — Quote Form" />
          <input type="hidden" name="redirect" value="https://floridafr44autoinsurance.com/quote/thank-you/" />
          <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

          <div class="form-row">
            <label for="q-name">Full name <span aria-hidden="true">*</span></label>
            <input id="q-name" name="name" type="text" required autocomplete="name" />
          </div>

          <div class="form-row-2">
            <div class="form-row">
              <label for="q-phone">Phone number <span aria-hidden="true">*</span></label>
              <input id="q-phone" name="phone" type="tel" required autocomplete="tel" />
            </div>
            <div class="form-row">
              <label for="q-email">Email address <span aria-hidden="true">*</span></label>
              <input id="q-email" name="email" type="email" required autocomplete="email" />
            </div>
          </div>

          <div class="form-row">
            <label for="q-city">City / ZIP code</label>
            <input id="q-city" name="city_zip" type="text" autocomplete="postal-code" />
          </div>

          <div class="form-row">
            <label for="q-coverage">Coverage needed <span aria-hidden="true">*</span></label>
            <select id="q-coverage" name="coverage_type" required>
              <option value="">Select an option</option>
              <option value="FR44">FR44 Insurance</option>
              <option value="SR22">SR22 Insurance</option>
              <option value="Standard Auto">Standard Auto Insurance</option>
              <option value="Not Sure">Not sure — need guidance</option>
            </select>
          </div>

          <div class="form-row-2">
            <div class="form-row">
              <label for="q-vehicle">Vehicle year / make / model</label>
              <input id="q-vehicle" name="vehicle" type="text" placeholder="e.g. 2019 Toyota Camry" />
            </div>
            <div class="form-row">
              <label for="q-contact-method">Preferred contact method</label>
              <select id="q-contact-method" name="preferred_contact">
                <option value="Text">Text</option>
                <option value="Call">Call</option>
                <option value="Email">Email</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <label for="q-notes">Anything else we should know?</label>
            <textarea id="q-notes" name="notes" rows="4"></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block">Get My Free Quote</button>
          <p class="form-disclaimer">By submitting, you agree to be contacted about your quote by phone, text, or email. Message and data rates may apply.</p>
          <div id="quote-form-status" class="form-status" role="status" aria-live="polite"></div>
        </form>

        <script>
          const quoteForm = document.getElementById('quote-form') as HTMLFormElement | null;
          const quoteStatus = document.getElementById('quote-form-status') as HTMLElement | null;

          quoteForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!quoteForm || !quoteStatus) return;
            const submitBtn = quoteForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
            if (!submitBtn) return;
            const originalLabel = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Sending…';
            quoteStatus.textContent = '';
            quoteStatus.className = 'form-status';

            try {
              const formData = new FormData(quoteForm);
              const response = await fetch(quoteForm.action, {
                method: 'POST',
                headers: { Accept: 'application/json' },
                body: formData,
              });
              const result = await response.json();

              if (result.success) {
                quoteForm.reset();
                quoteForm.hidden = true;
                quoteStatus.className = 'form-status form-status-success';
                quoteStatus.innerHTML =
                  "Thanks — your quote request is in! We'll be in touch shortly. Prefer it faster? <a href=\"sms:+17723143639\">Text us</a> anytime.";
              } else {
                throw new Error(result.message || 'Something went wrong.');
              }
            } catch (err) {
              quoteStatus.className = 'form-status form-status-error';
              quoteStatus.innerHTML =
                "Something went wrong sending your request. Please try again, or <a href=\"sms:+17723143639\">text us</a> directly at 772-314-3639.";
            } finally {
              submitBtn.disabled = false;
              submitBtn.textContent = originalLabel;
            }
          });
        </script>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .quote-hero { max-width: 720px; }
  .lead { font-size: 1.08rem; }
  .quote-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 3rem; align-items: start; }
  .benefit-list { list-style: none; padding: 0; margin: 1.5rem 0; display: flex; flex-direction: column; gap: 1rem; }
  .benefit-list li { display: flex; flex-direction: column; gap: 0.15rem; }
  .benefit-list strong { color: var(--color-ink); font-family: var(--font-display); }
  .benefit-list span { color: var(--color-gray-600); font-size: 0.92rem; }

  .agent-card {
    display: flex; gap: 1.1rem; align-items: flex-start;
    margin-top: 1.5rem;
  }
  .agent-avatar {
    flex-shrink: 0; width: 56px; height: 56px; border-radius: 50%;
    background: var(--color-ink); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 700; font-size: 1.1rem;
  }
  .agent-details .info-label {
    font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--color-gray-500);
  }
  .agent-details h3 { font-size: 1.05rem; margin: 0.2rem 0 0.1rem; }
  .agent-license { font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-gray-500); margin-bottom: 0.6rem; }
  .agent-note { font-size: 0.88rem; margin: 0; }

  .quote-text-cta {
    background: var(--color-blue-tint); border-radius: var(--radius-md);
    padding: 1.5rem; margin-top: 1.5rem;
  }
  .quote-text-cta h3 { font-size: 1rem; margin-bottom: 0.4rem; }
  .quote-text-cta p { font-size: 0.9rem; margin-bottom: 1rem; }

  .quote-form-wrap { padding: 2rem; }
  .form-note { font-size: 0.8rem; color: var(--color-gray-500); margin-bottom: 1.25rem; }
  .quote-form { display: flex; flex-direction: column; gap: 1.1rem; }
  .form-row { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  label { font-size: 0.88rem; font-weight: 600; color: var(--color-gray-700); }
  input, select, textarea {
    font-family: var(--font-body); font-size: 0.96rem;
    padding: 0.7rem 0.85rem; border-radius: var(--radius-sm);
    border: 1.5px solid var(--color-gray-300); background: #fff; color: var(--color-ink);
  }
  input:focus, select:focus, textarea:focus { border-color: var(--color-blue); outline: none; }
  .form-disclaimer { font-size: 0.76rem; color: var(--color-gray-500); text-align: center; }
  .form-status { font-size: 0.92rem; font-weight: 600; text-align: center; }
  .form-status:empty { display: none; }
  .form-status-success { color: #1a7a45; background: #e9f7ef; border-radius: var(--radius-sm); padding: 1rem; }
  .form-status-error { color: var(--color-accent-dark); background: #fdecea; border-radius: var(--radius-sm); padding: 1rem; }

  @media (max-width: 900px) {
    .quote-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .form-row-2 { grid-template-columns: 1fr; }
  }
</style>
