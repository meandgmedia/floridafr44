---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import PostCard from '@components/PostCard.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout
  title="Blog"
  description="Practical articles on FR44 insurance, SR22 insurance, and Florida auto coverage — written for drivers, not adjusters."
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Blog', href: '/blog/' }]} />
  </div>

  <section class="section-tight">
    <div class="container">
      <span class="eyebrow">Insights</span>
      <h1>The Florida FR44 blog</h1>
      <p class="lead">Straightforward articles on FR44, SR22, and Florida auto insurance — no jargon, just answers.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="grid grid-3">
        {posts.map((post) => (
          <PostCard
            href={`/blog/${post.slug}/`}
            title={post.data.title}
            description={post.data.description}
            image={post.data.image}
            imageAlt={post.data.imageAlt}
            category={post.data.category}
            date={post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
          />
        ))}
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .lead { max-width: 620px; font-size: 1.05rem; }
</style>
