---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { getCollection } from 'astro:content';
import { articleSchema } from '@data/schema';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await guide.render();

const schema = articleSchema({
  title: guide.data.title,
  description: guide.data.description,
  image: guide.data.image,
  datePublished: guide.data.pubDate.toISOString(),
  dateModified: guide.data.updatedDate?.toISOString(),
  slug: `/guides/${guide.slug}/`,
});
---
<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  ogImage={guide.data.image}
  ogType="article"
  schema={schema}
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Guides', href: '/guides/' }, { label: guide.data.title, href: `/guides/${guide.slug}/` }]} />
  </div>

  <article class="section-tight">
    <div class="container post-header">
      <span class="badge">Guide &middot; {guide.data.readTime}</span>
      <h1>{guide.data.title}</h1>
    </div>

    <div class="container post-image">
      <img src={guide.data.image} alt={guide.data.imageAlt} width="1200" height="500" />
    </div>

    <div class="container post-layout">
      <div class="post-content">
        <Content />

        <div class="post-cta-inline card">
          <h3>Ready for a fast FR44 or SR22 quote?</h3>
          <p>We compare multiple Florida carriers to help you find affordable coverage.</p>
          <div class="inline-actions">
            <a href="/quote/" class="btn btn-primary">Get a Free Quote</a>
            <a href="sms:+17722260875" class="btn btn-outline">Text Us</a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <CtaBanner />
</BaseLayout>

<style>
  .post-header { max-width: 760px; }
  .post-image { margin-top: 1.5rem; }
  .post-image img { border-radius: var(--radius-lg); width: 100%; object-fit: cover; aspect-ratio: 1200/500; }
  .post-layout { margin-top: 2.5rem; display: flex; justify-content: center; }
  .post-content { max-width: 720px; width: 100%; }
  .post-content :global(h2) { margin-top: 2.2rem; }
  .post-content :global(h3) { margin-top: 1.6rem; }
  .post-content :global(a) { text-decoration: underline; text-underline-offset: 2px; }
  .post-cta-inline { margin-top: 2.5rem; text-align: center; }
  .post-cta-inline h3 { margin-bottom: 0.4rem; }
  .inline-actions { display: flex; gap: 0.75rem; justify-content: center; margin-top: 1rem; flex-wrap: wrap; }
</style>
