---
import { site, footerLinks } from '@data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/images/logo.png" alt={`${site.name} logo`} width="280" height="77" class="footer-logo" />
      <p class="footer-tagline">{site.description}</p>
      <p class="footer-text-note">
        <strong>Text is the fastest way to reach us.</strong>
      </p>
      <div class="footer-contact">
        <a href={site.smsHref}>{site.phone} (text)</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>

    <nav class="footer-col" aria-label="Company">
      <h2>Company</h2>
      <ul>
        {footerLinks.company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Coverage">
      <h2>Coverage</h2>
      <ul>
        {footerLinks.coverage.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Legal">
      <h2>Legal</h2>
      <ul>
        {footerLinks.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="footer-state" aria-hidden="true">
    <img src="/images/florida-outline.png" alt="" width="456" height="433" loading="lazy" />
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {year} {site.name}. All rights reserved. Proudly serving all of Florida.</p>
      <p class="footer-disclaimer">
        {site.name} is an independent insurance agency and does not underwrite policies. Rates and availability vary by carrier and individual circumstances.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-white);
    color: var(--color-gray-700);
    border-top: 1px solid var(--color-border);
    padding-block: clamp(3rem, 6vw, 4.5rem) 0;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }
  .footer-logo { height: 60px; width: auto; margin-bottom: 1.1rem; }
  .footer-tagline { color: var(--color-gray-600); font-size: 0.92rem; max-width: 36ch; }
  .footer-text-note { color: var(--color-ink); font-size: 0.92rem; margin-top: 1rem; }
  .footer-contact { display: flex; flex-direction: column; gap: 0.3rem; margin-top: 0.5rem; }
  .footer-contact a { color: var(--color-accent); font-weight: 600; }
  .footer-contact a:hover { color: var(--color-accent-dark); }

  .footer-col h2 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gray-500);
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .footer-col ul { list-style: none; margin: 0 0 1.5rem; padding: 0; }
  .footer-col a { color: var(--color-accent); font-size: 0.94rem; }
  .footer-col a:hover { color: var(--color-accent-dark); }

  .footer-state {
    display: flex;
    justify-content: center;
    padding: 0.5rem 0 2.5rem;
  }
  .footer-state svg,
  .footer-state img { height: 120px; width: auto; }

  .footer-bottom { border-top: 1px solid var(--color-border); padding-block: 1.5rem; }
  .footer-bottom-inner { display: flex; flex-direction: column; gap: 0.4rem; }
  .footer-bottom p { margin: 0; font-size: 0.82rem; color: var(--color-gray-500); }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-state svg,
    .footer-state img { height: 90px; }
  }
</style>
