---
import { site, footerLinks } from '@data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/images/logo.png" alt={`${site.name} logo`} width="280" height="77" class="footer-logo" />
      <p class="footer-tagline">{site.description}</p>
      <p class="footer-text-note">
        <strong>Text is the fastest way to reach us.</strong>
      </p>
      <div class="footer-contact">
        <a href={site.smsHref}>{site.phone} (text)</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div class="footer-social">
        <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Matt Saffian on LinkedIn (opens in a new tab)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
        </a>
      </div>
    </div>

    <nav class="footer-col" aria-label="Company">
      <h2>Company</h2>
      <ul>
        {footerLinks.company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Coverage">
      <h2>Coverage</h2>
      <ul>
        {footerLinks.coverage.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Legal">
      <h2>Legal</h2>
      <ul>
        {footerLinks.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {year} {site.name}. All rights reserved. Proudly serving all of Florida.</p>
      <p class="footer-disclaimer">
        {site.name} is an independent insurance agency and does not underwrite policies. Rates and availability vary by carrier and individual circumstances.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-white);
    color: var(--color-gray-700);
    border-top: 1px solid var(--color-border);
    padding-block: clamp(3rem, 6vw, 4.5rem) 0;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }
  .footer-logo { height: 60px; width: auto; margin-bottom: 1.1rem; }
  .footer-tagline { color: var(--color-gray-600); font-size: 0.92rem; max-width: 36ch; }
  .footer-text-note { color: var(--color-ink); font-size: 0.92rem; margin-top: 1rem; }
  .footer-contact { display: flex; flex-direction: column; gap: 0.3rem; margin-top: 0.5rem; }
  .footer-contact a { color: var(--color-accent); font-weight: 600; }
  .footer-contact a:hover { color: var(--color-accent-dark); }

  .footer-social { display: flex; gap: 0.6rem; margin-top: 1.1rem; }
  .footer-social a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--color-gray-50); color: var(--color-gray-700);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .footer-social a:hover { background: var(--color-accent); color: #fff; }

  .footer-col h2 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gray-500);
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .footer-col ul { list-style: none; margin: 0 0 1.5rem; padding: 0; }
  .footer-col a { color: var(--color-accent); font-size: 0.94rem; }
  .footer-col a:hover { color: var(--color-accent-dark); }

  .footer-bottom { border-top: 1px solid var(--color-border); padding-block: 1.5rem; }
  .footer-bottom-inner { display: flex; flex-direction: column; gap: 0.4rem; }
  .footer-bottom p { margin: 0; font-size: 0.82rem; color: var(--color-gray-500); }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
