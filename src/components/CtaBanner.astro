---
import { site } from '@data/site';

interface Props {
  heading?: string;
  subtext?: string;
  variant?: 'dark' | 'light';
}

const {
  heading = 'Ready for the best FR-44 rate in Florida?',
  subtext = 'We compare multiple carriers and specialize in high-risk drivers other agencies turn away. Prefer texting? So do we.',
  variant = 'dark',
} = Astro.props;
---
<section class={`cta-banner ${variant}`}>
  <div class="container cta-inner">
    <div class="cta-copy">
      <h2>{heading}</h2>
      <p>{subtext}</p>
    </div>
    <div class="cta-actions">
      <a href="/quote/" class="btn btn-primary">Get a Free Quote</a>
      <a href={site.smsHref} class="btn btn-outline-light">Text {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .cta-banner.dark {
    background: var(--color-ink);
    color: #fff;
    border-radius: var(--radius-lg);
    margin-inline: 1.5rem;
  }
  .cta-banner.dark .cta-inner { max-width: var(--container-max); margin-inline: auto; padding-inline: 0; }
  .cta-banner.light {
    background: var(--color-blue-tint);
  }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .cta-copy { max-width: 520px; }
  .cta-banner.dark h2 { color: #fff; }
  .cta-banner.dark p { color: rgba(255,255,255,0.72); }
  .cta-banner.light h2 { color: var(--color-ink); }
  .cta-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .cta-banner.light .btn-outline-light { color: var(--color-ink); border-color: var(--color-gray-300); }
  .cta-banner.light .btn-outline-light:hover { border-color: var(--color-ink); background: rgba(11,18,32,0.05); }

  @media (max-width: 950px) {
    .cta-inner { flex-direction: column; text-align: center; }
    .cta-copy { max-width: 100%; }
    .cta-actions { justify-content: center; width: 100%; }
  }
</style>
