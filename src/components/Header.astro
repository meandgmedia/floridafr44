---
import { site, navLinks } from '@data/site';

const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name} — Home`}>
      <img src="/images/logo.png" alt={`${site.name} logo`} width="220" height="60" class="brand-logo" />
    </a>

    <nav class="main-nav" aria-label="Primary">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-ctas">
      <a href={site.smsHref} class="btn btn-outline btn-sm header-text-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4h16v12H7l-3 3V4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        Text Us
      </a>
      <a href="/quote/" class="btn btn-primary btn-sm">Get a Free Quote</a>
    </div>

    <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden>
    <ul>
      {navLinks.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <div class="mobile-ctas">
      <a href={site.smsHref} class="btn btn-navy btn-block">Text {site.phone}</a>
      <a href="/quote/" class="btn btn-primary btn-block">Get a Free Quote</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--color-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-h);
  }
  .brand { display: flex; align-items: center; flex-shrink: 0; }
  .brand-logo { height: 38px; width: auto; }

  .main-nav { flex: 1; display: flex; justify-content: center; }
  .main-nav ul {
    display: flex;
    list-style: none;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
  }
  .main-nav a {
    color: var(--color-gray-700);
    font-weight: 600;
    font-size: 0.94rem;
    white-space: nowrap;
  }
  .main-nav a:hover { color: var(--color-ink); }
  .main-nav a[aria-current='page'] { color: var(--color-blue); }

  .header-ctas { display: flex; align-items: center; gap: 0.6rem; flex-shrink: 0; }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 0.4rem;
    color: var(--color-ink);
    cursor: pointer;
  }

  .mobile-nav { display: none; }

  @media (max-width: 980px) {
    .main-nav, .header-ctas { display: none; }
    .menu-toggle { display: inline-flex; }
    .mobile-nav[hidden] { display: none; }
    .mobile-nav {
      display: block;
      background: var(--color-white);
      border-bottom: 1px solid var(--color-border);
      padding: 1rem 1.5rem 1.5rem;
    }
    .mobile-nav ul {
      list-style: none;
      margin: 0 0 1rem;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .mobile-nav a {
      display: block;
      padding: 0.6rem 0.2rem;
      font-weight: 600;
      color: var(--color-gray-700);
      border-bottom: 1px solid var(--color-gray-100);
    }
    .mobile-ctas { display: flex; flex-direction: column; gap: 0.6rem; }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = nav?.hasAttribute('hidden') === false;
    if (isOpen) {
      nav?.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
    } else {
      nav?.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
    }
  });
</script>
