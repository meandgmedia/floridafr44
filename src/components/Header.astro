---
import { site, navMain, navResources, navEnd, navLinks } from '@data/site';

const currentPath = Astro.url.pathname;
const isResourceActive = navResources.some((l) => l.href === currentPath);
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name} — Home`}>
      <img src="/images/logo.png" alt={`${site.name} logo`} width="288" height="60" class="brand-logo" />
    </a>

    <nav class="main-nav" aria-label="Primary">
      <ul>
        {navMain.map((link) => (
          <li>
            <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
        <li class="nav-dropdown">
          <button type="button" class="dropdown-trigger" aria-current={isResourceActive ? 'page' : undefined}>
            Resources
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <ul class="dropdown-menu">
            {navResources.map((link) => (
              <li><a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a></li>
            ))}
          </ul>
        </li>
        {navEnd.map((link) => (
          <li>
            <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-ctas">
      <a href={site.smsHref} class="btn btn-outline btn-sm header-text-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4h16v12H7l-3 3V4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        Text Us
      </a>
      <a href="/quote/" class="btn btn-primary btn-sm">Get a Free Quote</a>
    </div>

    <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden>
    <ul class="mobile-nav-list">
      {navLinks.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <div class="mobile-ctas">
      <a href={site.smsHref} class="btn btn-navy btn-block">Text {site.phone}</a>
      <a href="/quote/" class="btn btn-primary btn-block">Get a Free Quote</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--color-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: var(--header-h);
  }
  .brand { display: flex; align-items: center; flex-shrink: 0; }
  .brand-logo { height: 40px; width: auto; }

  .main-nav { flex: 1; display: flex; justify-content: center; min-width: 0; overflow: hidden; }
  .main-nav ul {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }
  .main-nav > ul > li { display: flex; align-items: center; }
  .main-nav a {
    color: var(--color-gray-700);
    font-weight: 600;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .main-nav a:hover { color: var(--color-ink); }
  .main-nav a[aria-current='page'] { color: var(--color-blue); }

  /* Resources dropdown */
  .nav-dropdown { position: relative; }
  .dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    background: none;
    border: none;
    padding: 0;
    color: var(--color-gray-700);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .dropdown-trigger:hover { color: var(--color-ink); }
  .dropdown-trigger[aria-current='page'] { color: var(--color-blue); }
  .dropdown-trigger svg { transition: transform 0.15s ease; }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    transform: translateX(-50%);
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    min-width: 150px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  }
  .dropdown-menu li a {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    white-space: nowrap;
  }
  .dropdown-menu li a:hover { background: var(--color-gray-50); }

  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .nav-dropdown:hover .dropdown-trigger svg,
  .nav-dropdown:focus-within .dropdown-trigger svg {
    transform: rotate(180deg);
  }

  .header-ctas { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 0.4rem;
    color: var(--color-ink);
    cursor: pointer;
  }

  .mobile-nav { display: none; }

  /* Collapse to hamburger well before overflow risk, and shrink
     nav gaps first at a mid-size desktop breakpoint to buy extra room. */
  @media (max-width: 1320px) and (min-width: 1101px) {
    .brand-logo { height: 28px; }
    .main-nav ul { gap: 0.7rem; }
    .main-nav a, .dropdown-trigger { font-size: 0.8rem; }
    .header-ctas { gap: 0.4rem; }
    .header-text-btn { padding-inline: 0.8rem; }
  }

  @media (max-width: 1100px) {
    .main-nav, .header-ctas { display: none; }
    .menu-toggle { display: inline-flex; }
    .mobile-nav[hidden] { display: none; }
    .mobile-nav {
      display: block;
      background: var(--color-white);
      border-bottom: 1px solid var(--color-border);
      padding: 1rem 1.5rem 1.5rem;
    }
    .mobile-nav-list {
      list-style: none;
      margin: 0 0 1rem;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .mobile-nav-list a {
      display: block;
      padding: 0.6rem 0.2rem;
      font-weight: 600;
      color: var(--color-gray-700);
      border-bottom: 1px solid var(--color-gray-100);
    }
    .mobile-ctas { display: flex; flex-direction: column; gap: 0.6rem; }
    .mobile-ctas a { color: #fff; }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = nav?.hasAttribute('hidden') === false;
    if (isOpen) {
      nav?.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
    } else {
      nav?.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
    }
  });
</script>
