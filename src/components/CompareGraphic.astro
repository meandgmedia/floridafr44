---
// Signature visual: a "rate comparison" bar chart representing the core
// value proposition — we check multiple carriers and surface the best rate.
// Note: bar values are illustrative, not real quoted rates for these carriers.
const bars = [
  { label: 'Allstate', value: 42, highlight: true },
  { label: 'National General', value: 58, highlight: false },
  { label: 'Progressive', value: 68, highlight: false },
  { label: 'GEICO', value: 78, highlight: false },
];
const maxVal = 90;
---
<div class="compare-graphic" role="img" aria-label="Illustration comparing insurance rates across four carriers, with the lowest rate highlighted">
  <div class="compare-card">
    <div class="compare-head">
      <span class="dot"></span>
      <span class="compare-title">Comparing Florida carriers…</span>
    </div>
    <div class="bars">
      {bars.map((bar, i) => (
        <div class="bar-row" style={`--delay:${i * 0.12}s`}>
          <span class="bar-label">{bar.label}</span>
          <div class="bar-track">
            <div class={`bar-fill ${bar.highlight ? 'is-best' : ''}`} style={`--w:${(bar.value / maxVal) * 100}%`}></div>
          </div>
          {bar.highlight && <span class="best-tag">Best rate</span>}
        </div>
      ))}
    </div>
    <p class="compare-disclaimer">Example for illustration — actual rates vary by driver.</p>
  </div>
</div>

<style>
  .compare-graphic {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-lg);
  }
  .compare-card { display: flex; flex-direction: column; gap: 1.1rem; }
  .compare-head { display: flex; align-items: center; gap: 0.6rem; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: #23a35a; box-shadow: 0 0 0 4px rgba(35,163,90,0.15); }
  .compare-title { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em; color: var(--color-gray-600); }

  .bars { display: flex; flex-direction: column; gap: 0.85rem; }
  .bar-row { display: grid; grid-template-columns: 112px 1fr auto; align-items: center; gap: 0.75rem; }
  .bar-label { font-size: 0.78rem; color: var(--color-gray-700); font-weight: 600; }
  .bar-track { background: var(--color-gray-100); border-radius: var(--radius-full); height: 12px; overflow: hidden; }
  .bar-fill {
    height: 100%;
    width: 0;
    border-radius: var(--radius-full);
    background: linear-gradient(90deg, #4c7bf0, #2755d6);
    animation: grow 1s ease forwards;
    animation-delay: var(--delay);
  }
  .bar-fill.is-best { background: linear-gradient(90deg, #ff6a61, var(--color-accent)); }
  .best-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    background: var(--color-blue-tint);
    color: var(--color-accent-dark);
    padding: 0.2em 0.55em;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }
  .compare-disclaimer {
    font-size: 0.72rem;
    color: var(--color-gray-500);
    margin: 0;
    text-align: right;
  }

  @keyframes grow {
    from { width: 0; }
    to { width: var(--w); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar-fill { animation: none; width: var(--w); }
  }

  @media (max-width: 400px) {
    .bar-row { grid-template-columns: 90px 1fr auto; }
    .bar-label { font-size: 0.7rem; }
  }
</style>
