---
interface FaqItem { question: string; answer: string; }
interface Props {
  items: FaqItem[];
  emitSchema?: boolean;
}
const { items, emitSchema = true } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---
<div class="faq-accordion">
  {items.map((item, i) => (
    <details class="faq-item" name={`faq-group-${Astro.props.items.length}`}>
      <summary>
        <span>{item.question}</span>
        <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </summary>
      <div class="faq-answer"><p set:html={item.answer} /></div>
    </details>
  ))}
</div>

{emitSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

<style>
  .faq-accordion { display: flex; flex-direction: column; gap: 0.75rem; }
  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    padding: 0.25rem 1.25rem;
  }
  .faq-item[open] { box-shadow: var(--shadow-sm); }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0;
    cursor: pointer;
    font-weight: 700;
    font-family: var(--font-display);
    font-size: 1.02rem;
    color: var(--color-ink);
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .chevron { flex-shrink: 0; color: var(--color-blue); transition: transform 0.2s ease; }
  .faq-item[open] .chevron { transform: rotate(180deg); }
  .faq-answer { padding-bottom: 1.15rem; color: var(--color-gray-700); }
  .faq-answer p { margin: 0; }
</style>
