---
import { site } from '@data/site';

interface Crumb { label: string; href: string; }
interface Props { items: Crumb[]; }
const { items } = Astro.props;

const allItems = [{ label: 'Home', href: '/' }, ...items];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: allItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    item: new URL(item.href, site.url).toString(),
  })),
};
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {allItems.map((item, i) => (
      <li>
        {i === allItems.length - 1 ? (
          <span aria-current="page">{item.label}</span>
        ) : (
          <>
            <a href={item.href}>{item.label}</a>
            <span class="sep" aria-hidden="true">/</span>
          </>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .breadcrumbs { padding-block: 1rem; }
  .breadcrumbs ol { list-style: none; display: flex; flex-wrap: wrap; margin: 0; padding: 0; gap: 0.35rem; }
  .breadcrumbs li { display: flex; align-items: center; gap: 0.35rem; font-size: 0.85rem; }
  .breadcrumbs a { color: var(--color-gray-500); font-weight: 500; }
  .breadcrumbs a:hover { color: var(--color-blue); }
  .breadcrumbs span[aria-current] { color: var(--color-gray-700); font-weight: 600; }
  .breadcrumbs .sep { color: var(--color-gray-300); }
</style>
